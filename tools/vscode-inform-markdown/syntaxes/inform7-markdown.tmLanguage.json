{
  "scopeName": "markdown.inform7.injection",
  "injectionSelector": "L:text.html.markdown - markup.fenced_code.block.markdown - markup.raw.block.markdown - markup.inline.raw.string.markdown",
  "patterns": [{ "include": "#backticks" }, { "include": "#tildes" }],
  "repository": {
    "backticks": {
      "begin": "(^|\\G)([ \\t]*)(`{3,})[ \\t]*(?i:(inform7|i7))(?=[ \\t]|$)[^`]*$",
      "end": "(^|\\G)(\\2|[ \\t]{0,3})(\\3`*)[ \\t]*$",
      "name": "markup.fenced_code.block.markdown",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" }
      },
      "endCaptures": { "3": { "name": "punctuation.definition.markdown" } },
      "patterns": [
        {
          "begin": "(^|\\G)",
          "while": "(^|\\G)(?![ \\t]*`{3,}[ \\t]*$)",
          "contentName": "meta.embedded.block.inform7 source.inform7",
          "patterns": [{ "include": "source.inform7" }]
        }
      ]
    },
    "tildes": {
      "begin": "(^|\\G)([ \\t]*)(~{3,})[ \\t]*(?i:(inform7|i7))(?=[ \\t]|$).*$",
      "end": "(^|\\G)(\\2|[ \\t]{0,3})(\\3~*)[ \\t]*$",
      "name": "markup.fenced_code.block.markdown",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" }
      },
      "endCaptures": { "3": { "name": "punctuation.definition.markdown" } },
      "patterns": [
        {
          "begin": "(^|\\G)",
          "while": "(^|\\G)(?![ \\t]*~{3,}[ \\t]*$)",
          "contentName": "meta.embedded.block.inform7 source.inform7",
          "patterns": [{ "include": "source.inform7" }]
        }
      ]
    }
  }
}
